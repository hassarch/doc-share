# ==== Java / Gradle / Maven (backend/) ====
backend/target/
backend/build/
backend/bin/
backend/out/
!backend/gradle/wrapper/gradle-wrapper.jar
backend/.gradle/
backend/.mvn/wrapper/maven-wrapper.jar

# ==== Next.js / Node (frontend/) ====
# frontend/ has its own .gitignore (generated by create-next-app), scoped
# locally to that folder — nothing duplicated here.

# ==== Infra (infra/) ====
infra/volumes/
infra/*.local.yml

# ==== Shared: env / secrets — never commit real secrets ====
.env
.env.local
*.env
!.env.example
!**/.env.example

# ==== Shared: OS ====
.DS_Store
Thumbs.db

# ==== Shared: IDE ====
.idea/
*.iml
*.iws
.vscode/
.settings/
.project
.classpath
*.launch

# ==== Shared: logs ====
*.log
logs/

# ==== Testcontainers ====
.testcontainers.properties
