# Copy to .env.prod and fill in real values before running
# docker-compose.prod.yml. NEVER commit .env.prod - only this .example
# file is tracked in git.
#
# For an actual cloud deployment, these belong in a real secrets manager
# (AWS Secrets Manager, GCP Secret Manager, Doppler, Vault, etc.), not a
# .env file on a server's disk - this file is the local/self-hosted-demo
# equivalent, not a recommendation for how to run this in production at
# scale.

# --- Database ---
DB_PASSWORD=replace-with-a-real-password

# --- Object storage (MinIO) ---
MINIO_ACCESS_KEY=replace-with-a-real-access-key
MINIO_SECRET_KEY=replace-with-a-real-secret-key-at-least-8-chars

# --- Auth ---
# Generate with: openssl rand -base64 48
# Must be at least 32 bytes for HS256 - the local-dev default in
# application.yml is intentionally NOT safe to reuse here.
JWT_SECRET=replace-with-a-real-random-secret

# --- Networking ---
# The frontend's real public origin - used by the backend for CORS and
# WebSocket allowed-origin checks. No trailing slash.
FRONTEND_ORIGIN=https://your-frontend-domain.example.com

# The backend's real public URL, as the frontend's browser JS will call
# it - baked into the frontend's build (see frontend/Dockerfile). No
# trailing slash.
BACKEND_PUBLIC_URL=https://your-backend-domain.example.com
